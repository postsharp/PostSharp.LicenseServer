<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpCrafters.LicenseServer.Test</RootNamespace>
    <AssemblyName>PostSharp.LicenseServer.Simulator</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- A manual load-testing tool, not a test suite: excluded from `dotnet test`. -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PostSharp.Compiler.Common" />
    <PackageReference Include="PostSharp.Compiler.Settings" />
    <PackageReference Include="PostSharp.Compiler.Platforms" />
    <PackageReference Include="PostSharp.Compiler.Engine" />
  </ItemGroup>

</Project>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PostSharp License Server</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="~/img/icons/apple-icon-152x152.png" />
    <meta name="theme-color" content="#191321" />
    <meta name="robots" content="noindex, nofollow" />
    @await RenderSectionAsync( "Head", required: false )
</head>
<body>
<header class="company-bar">
    <div class="company-bar__inner">
        <a class="company-bar__logo" asp-page="/Index" title="Go to the licenses">
            <img src="~/img/postsharp-logo.svg" width="180" alt="PostSharp" />
        </a>
        <span class="company-bar__title">License Server</span>
        <nav class="company-bar__nav" aria-label="Main">
            <a asp-page="/Index">Licenses</a>
            <a asp-page="/Admin/AddLicense">Add a license</a>
            <a asp-page="/Admin/Export">Audit log</a>
        </nav>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    PostSharp and Metalama are trade names of SharpCrafters s.r.o. &copy; 2004&ndash;@DateTime.UtcNow.Year.
</footer>

@await RenderSectionAsync( "Scripts", required: false )
</body>
</html>

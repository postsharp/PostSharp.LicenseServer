@page
@model SharpCrafters.Backstage.LicenseServer.Pages.Admin.DetailsModel
@{
    ViewData["Title"] = $"License {Model.Id}";
}

<div class="page-header">
    <h2>License @Model.Id</h2>
    <p><a asp-page="/Index">Back</a></p>
</div>

<p>
    <strong>@Model.Leases.Count</strong> current lease(s), consuming
    <strong>@Model.Seats</strong> seat(s).
    <a asp-page="/Graph" asp-route-id="@Model.Id">See the usage history</a>.
</p>

<p class="note">
    A seat is one user working on up to @Model.MachinesPerSeatText. A user working on more machines
    takes more than one seat: the number of machines divided by @Model.MachinesPerSeat, rounded up.
    The capacity of a license is a number of seats.
</p>

@if ( Model.Leases.Count == 0 )
{
    <p>No lease is currently held against this license.</p>
}
else
{
    <div class="table-scroll">
        <table>
        <thead>
        <tr>
            <th>Lease</th>
            <th>User</th>
            <th>Machine</th>
            <th>Start</th>
            <th>End</th>
            <th>Grace</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach ( var lease in Model.Leases )
        {
            <tr>
                <td>@lease.LeaseId</td>
                <td>@lease.UserName</td>
                <td>@lease.Machine</td>
                <td>@lease.StartTime.ToString( "g" )</td>
                <td>@lease.EndTime.ToString( "g" )</td>
                <td>@(lease.Grace ? "Yes" : "")</td>
                <td><a asp-page="/Admin/Cancel" asp-route-id="@lease.LeaseId">Cancel</a></td>
            </tr>
        }
        </tbody>
        </table>
    </div>
}

<h3>Manage this license</h3>

@* A div and not a paragraph: a paragraph cannot contain a form, so the browser closed it at the
   first form and left an empty panel behind, with the buttons outside it. *@
<div class="actions panel">
    @if ( Model.IsDisabled )
    {
        <form method="post" asp-page-handler="Enable">
            <button type="submit">Enable</button>
        </form>

        <form method="post" asp-page-handler="Delete"
              onsubmit="return confirm('Delete this license and all of its leases? This cannot be undone.');">
            <button type="submit">Delete</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Disable">
            <button type="submit">Disable</button>
        </form>

        <p class="note">A disabled license serves no new lease, and can then be deleted.</p>
    }
</div>

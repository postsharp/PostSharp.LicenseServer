@page
@model GraphModel
@{
    ViewData["Title"] = $"Usage of license {Model.Id}";
}

@section Head {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
}

<p class="toolbar">
    <a asp-page="/Index">Back</a>
</p>

<h2>License @Model.Id: @Model.Days-day usage history</h2>

<p>
    @foreach ( int window in GraphModel.AllowedWindows )
    {
        if ( window != GraphModel.AllowedWindows[0] )
        {
            <text>| </text>
        }

        if ( window == Model.Days )
        {
            <strong>@window days</strong>
        }
        else
        {
            <a asp-page="/Graph" asp-route-id="@Model.Id" asp-route-days="@window">@window days</a>
        }
    }
</p>

<div id="usage-chart-container">
    <canvas id="usage-chart"></canvas>
</div>

@* The data travels as JSON in its own element rather than interpolated into a script body, where a
   closing script tag inside a string would end the block. Razor encodes the content. *@
<script id="usage-chart-data" type="application/json">@Json.Serialize( Model.Chart )</script>

@section Scripts {
    <script src="~/js/graph.js" asp-append-version="true"></script>
}

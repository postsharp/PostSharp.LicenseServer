# Normalize line endings, so that the repository is the same on every platform.
* text=auto

*.cs      text diff=csharp
*.cshtml  text
*.csproj  text
*.props   text
*.slnx    text
*.json    text
*.md      text
*.css     text
*.js      text
*.sql     text
*.ps1     text eol=crlf
*.sh      text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf

*.png     binary
*.ico     binary
*.woff    binary
*.woff2   binary
